{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/webhook-cx",
      "dest": "/api/webhook-cx.py"
    },
    {
      "src": "/webhook-ig-cx",
      "dest": "/api/webhook-ig-cx.py"
    },
    {
      "src": "/webhook-ig-cx-simple",
      "dest": "/api/webhook-ig-cx-simple.py"
    }
  ]
}
